APP_ENV=development
DATABASE_URL=sqlite:///./aquarizz.db

# Authentication routes fail closed until a deployment-specific secret is configured.
# JWT_SECRET=

# To switch the same SQLAlchemy model layer to a PostGIS-enabled PostgreSQL service later,
# replace DATABASE_URL with a URL using the installed psycopg2 driver, for example:
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/aquarizz
